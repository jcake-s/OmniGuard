# OmniGuard Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml for local development
# Or enter these environment secrets in Streamlit Community Cloud settings

# Google AI Studio Gemini API Key (Free tier at https://aistudio.google.com)
GEMINI_API_KEY = "your-google-ai-studio-gemini-api-key"

# Gemini Model Selection (default: gemini-2.5-flash or gemini-3-flash-preview)
GEMINI_MODEL = "gemini-2.5-flash"

# Supabase Credentials (Free tier at https://supabase.com)
# Leave blank or set to "demo" to use the built-in Offline Mock Database
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your-supabase-anon-key"
